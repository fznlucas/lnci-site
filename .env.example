# Variables publiques du site, injectees au build (prefixe VITE_).
# Copier ce fichier en .env et renseigner les valeurs. Ne jamais y mettre
# de secret : tout ce qui commence par VITE_ finit dans le JavaScript public.

# Adresse de l'API des formulaires, sans barre finale.
# Vide : les formulaires affichent le message de repli avec l'adresse de contact.
VITE_API_URL=

# Page LinkedIn de l'evenement. Vide : les liens LinkedIn sont masques.
VITE_LINKEDIN_URL=
