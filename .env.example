# Variables publiques du site, injectées au build (préfixe VITE_).
# Copier ce fichier en .env et le remplir ; rebuilder après chaque changement.
# Jamais de secret ici : tout ce qui commence par VITE_ finit dans le JavaScript public.

# Adresse de l'API des formulaires, sans barre finale (contrat : docs/BACKEND.md).
# Exemple : VITE_API_URL=https://api.nuitsducapitalinvestissement.fr
# Vide : les formulaires n'envoient rien et affichent un message de repli avec l'adresse de contact.
VITE_API_URL=

# Page LinkedIn de l'événement.
# Exemple : VITE_LINKEDIN_URL=https://www.linkedin.com/company/...
# Vide : le lien LinkedIn du pied de page est masqué.
VITE_LINKEDIN_URL=
